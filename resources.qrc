        <file alias="GuitarTabStudio_logo.png">assets/icons/GuitarTabStudio_logo.png</file>
        <file alias="play.png">assets/icons/play.png</file>
        <file alias="pause.png">assets/icons/pause.png</file>
        <file alias="stop.png">assets/icons/stop.png</file>
        <file alias="single_coil.png">assets/icons/single_coil.png</file>
        <file alias="humbucker.png">assets/icons/humbucker.png</file>
        <file alias="pedal_chorus.png">assets/icons/pedal_chorus.png</file>
    </qresource>
    <qresource prefix="/intro">
        <file alias="intro_chords.wav">assets/intro/intro_chords.wav</file>
    </qresource>
</RCC>